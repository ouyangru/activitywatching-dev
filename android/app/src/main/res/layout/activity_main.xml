<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="行迹 · 手机采集器"
            android:textColor="#10251B"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="只记录前台应用、使用时长和锁屏状态，不读取输入文字、剪贴板原文或触摸坐标。"
            android:textColor="#496257"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/permissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="正在检查使用情况访问权限…"
            android:textColor="#10251B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/grantPermissionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="打开系统权限页面" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="后端地址（同一 Wi‑Fi 下的电脑地址）"
            android:textColor="#10251B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如 http://192.168.1.20:8765"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="API Token"
            android:textColor="#10251B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="与后端 ACTIVITYWATCH_API_TOKEN 一致"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="设备名称"
            android:textColor="#10251B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/deviceIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="android-phone"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/monitoringEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="启用后台采集与自动上传" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="保存并启动" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="测试局域网连接" />

        <Button
            android:id="@+id/syncButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="立即采集并上传" />

        <Button
            android:id="@+id/batteryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="申请忽略电池优化" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="OPPO / vivo / 一加手机请额外设置：系统设置 → 电池 → 应用耗电管理 → 行迹 → 允许完全后台行为；并在最近任务中下拉锁定本应用。否则系统仍可能杀掉后台服务。"
            android:textColor="#8a6d3b"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/runtimeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#E3EFE8"
            android:padding="16dp"
            android:text="尚未启动"
            android:textColor="#244B38"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="说明：保存启动后会出现常驻通知，前台服务每分钟采集一次并即时上传；WorkManager 定时任务保留作为兜底，即使服务被系统杀死，重新运行后也会按游标补齐断档数据。事件本身带时间戳，不会把后台间隔误算成应用使用。"
            android:textColor="#5C7167"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
