ACTIVITYWATCH_DB_PATH=backend/data/activitywatch.db
ACTIVITYWATCH_TIMEZONE=Asia/Shanghai
ACTIVITYWATCH_RULES_PATH=backend/config/rules.yaml
# Required when the service is reachable beyond localhost.
ACTIVITYWATCH_API_TOKEN=replace-with-a-long-random-token

# Agent 语义增强层（可选；三项齐全才启用，缺省时全部接口走规则）
# 规则永远先跑出完整底账，Agent 结果按内容缓存覆盖 behavior/purpose/topic，
# 模型不可用时自动回退规则值，核心功能不受影响。
# 接口需兼容 OpenAI /chat/completions 格式。
#ACTIVITYWATCH_AGENT_BASE_URL=https://api.example.com/v1
#ACTIVITYWATCH_AGENT_API_KEY=
#ACTIVITYWATCH_AGENT_MODEL=
# 设为 0 可在配置齐全的情况下强制关闭
#ACTIVITYWATCH_AGENT_ENABLED=1

