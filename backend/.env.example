ACTIVITYWATCH_DB_PATH=backend/data/activitywatch.db
ACTIVITYWATCH_TIMEZONE=Asia/Shanghai
ACTIVITYWATCH_RULES_PATH=backend/config/rules.yaml
# Required when the service is reachable beyond localhost.
ACTIVITYWATCH_API_TOKEN=replace-with-a-long-random-token

# QQ 邮箱秋招提醒（授权码不是 QQ 密码）
# 在 QQ 邮箱设置中开启 IMAP/SMTP 后生成授权码，只把授权码写进服务器环境变量。
QQ_EMAIL=
QQ_EMAIL_AUTH_CODE=
QQ_IMAP_HOST=imap.qq.com
QQ_IMAP_PORT=993
QQ_IMAP_MAILBOX=INBOX
# 默认每 10 分钟自动检查一次；最小 60 秒。设为 0 可关闭后台自动扫描。
RECRUITMENT_AUTO_SCAN=1
RECRUITMENT_SCAN_INTERVAL_SECONDS=600

# Google Calendar 同步（可选）
# 在 Google Cloud 创建 OAuth 2.0 Web application，并启用 Google Calendar API。
# Google Web OAuth 不接受公网裸 IP 作为 redirect host，因此生产环境需要 HTTPS 域名。
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
# 必须与 Google Cloud 中 Authorized redirect URI 完全一致，例如：
# GOOGLE_CALENDAR_REDIRECT_URI=https://activity.example.com/api/v1/recruitment/calendar/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=

# 飞书招聘进度表（可选）
# 创建企业自建应用并给目标多维表格授予读取/编辑权限；Secret 只放服务器环境变量。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 直接配置 app_token，或配置 Wiki 节点 token 让后端解析；二选一即可。
FEISHU_RECRUITMENT_APP_TOKEN=
FEISHU_RECRUITMENT_WIKI_TOKEN=
FEISHU_RECRUITMENT_TABLE_ID=
FEISHU_RECRUITMENT_VIEW_ID=
# 原始飞书表链接，仅用于网页上的“打开飞书原表”按钮。
FEISHU_RECRUITMENT_SOURCE_URL=
# 字段名可按你的实际多维表格覆盖。所有修改均先进入审核队列，不会直接写入。
FEISHU_RECRUITMENT_COMPANY_FIELD=公司
FEISHU_RECRUITMENT_STAGE_FIELD=招聘进度
FEISHU_RECRUITMENT_LATEST_FIELD=最新动态
FEISHU_RECRUITMENT_NEXT_FIELD=下一节点

# Agent 语义增强层（可选；三项齐全才启用，缺省时全部接口走规则）
# 规则永远先跑出完整底账，Agent 结果按内容缓存覆盖 behavior/purpose/topic，
# 模型不可用时自动回退规则值，核心功能不受影响。
# 接口需兼容 OpenAI /chat/completions 格式。
#ACTIVITYWATCH_AGENT_BASE_URL=https://api.example.com/v1
#ACTIVITYWATCH_AGENT_API_KEY=
#ACTIVITYWATCH_AGENT_MODEL=
# 设为 0 可在配置齐全的情况下强制关闭
#ACTIVITYWATCH_AGENT_ENABLED=1

